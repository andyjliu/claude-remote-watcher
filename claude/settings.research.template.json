      "Edit(//{{STATE}}/standing_orders.md)", "Write(//{{STATE}}/standing_orders.md)",
      "Edit(//{{STATE}}/research/**)", "Write(//{{STATE}}/research/**)",
      "Edit(//{{STATE}}/turns/**)", "Write(//{{STATE}}/turns/**)",
      "Edit(//{{CONF_DIR}}/**)", "Write(//{{CONF_DIR}}/**)",
      "Edit(//{{REPO}}/**)", "Write(//{{REPO}}/**)"
