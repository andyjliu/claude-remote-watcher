      "Bash(pip install --user:*)", "Bash(uv tool install:*)", "Bash(npm install -g:*)",
      "Read(//{{TARGET}}/.env)", "Read(//{{TARGET}}/**/.env)", "Read(~/.ssh/**)", "Read(//{{CONF_DIR}}/**)",
