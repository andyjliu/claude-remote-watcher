      "Bash(scontrol update:*)", "Bash(scontrol delete:*)", "Bash(sacctmgr:*)",
      "Bash(crontab:*)", "Bash(scrontab:*)",
      "Bash(git merge:*)", "Bash(git rebase:*)", "Bash(git reset --hard:*)", "Bash(git clean:*)",
      "Bash(git commit --amend:*)", "Bash(git filter-branch:*)", "Bash(git branch -D:*)", "Bash(git tag -d:*)",
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git push --force-with-lease:*)", "Bash(git push --delete:*)",
      "Bash(git push origin main:*)", "Bash(git push origin master:*)", "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin HEAD:master:*)", "Bash(git push origin +:*)",
      "Bash(git remote set-url:*)", "Bash(git remote remove:*)", "Bash(git remote add:*)",
      "Bash(git switch --discard-changes:*)", "Bash(git switch -f:*)", "Bash(git switch --force:*)",
